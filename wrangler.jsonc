{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grok-mcp",
  "main": "worker.ts",
  "compatibility_date": "2026-09-30",
  "observability": { "enabled": true },
  // ffmpeg (render/audio tools) and rembg's ONNX model need a real Linux box.
  // standard-2 is 1 vCPU / 6 GiB / 12 GB disk: ffmpeg encodes are CPU-bound,
  // rembg holds a ~170 MB model in memory, and the image is ~2 GB.
  "containers": [
    {
      // Built by Workers Builds on push to main (native amd64, no local Docker).
      "image": "./Dockerfile",
      "class_name": "GrokMcp",
      "instance_type": "standard-2",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "GROK_MCP", "class_name": "GrokMcp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GrokMcp"] }],
  "vars": {
    // Must equal the public hostname: the server allow-lists it as the Host
    // header and issues OAuth metadata for it. Flip to grok.deeporax.com at cutover.
    "DOMAIN": "grok-mcp.imfaisii009.workers.dev",
    "MCP_PATH": "/mcp",
    "R2_BUCKET": "social-automations",
    "R2_PUBLIC_BASE": "https://pub-d32ba5d03dba4262b2552ed6e1f5f223.r2.dev",
    "R2_CHATS_BUCKET": "grok-mcp-chats"
  }
}
