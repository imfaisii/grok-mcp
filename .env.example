# Copy to .env and fill in, or just run ./deploy.sh and let it write this for you.
# Comments must be on their own line: docker compose does not reliably strip
# trailing comments, so `MCP_PORT=8000  # the port` would set the port to
# the literal string "8000  # the port".

# xAI API key, starts with "xai-"
XAI_API_KEY=xai-your-key-here

# http for server deployment, stdio for a local MCP client
MCP_TRANSPORT=http

# Bind address inside the container
MCP_HOST=0.0.0.0

# Port the app listens on
MCP_PORT=8000

# Path the MCP endpoint is served on
MCP_PATH=/mcp

# Bearer token clients must send. deploy.sh generates one; treat it as a password.
MCP_AUTH_TOKEN=

# Optional. When set, the MCP endpoint is ALSO served at /<secret>/mcp with no
# Authorization header required, for clients that cannot send one (claude.ai
# custom connectors). The URL then is the password: treat it like one.
MCP_URL_SECRET=

# Public hostname clients will connect to
DOMAIN=mcp.example.com

# Email for Let's Encrypt expiry notices
ACME_EMAIL=you@example.com

# HTTPS port Caddy listens on. Change it only when something else already
# owns 443 on the host; clients then need the port in the URL, and claude.ai
# custom connectors cannot use a non-443 port. Use SNI_FALLBACK instead when
# a claude.ai connector needs to reach this server.
HTTPS_PORT=443

# Optional. Set this to share port 443 with a service that already owns it.
# Value is host:port where that other service now listens, e.g. 127.0.0.1:8444.
# When set, deploy.sh runs the 'sni' profile: nginx takes 443, routes DOMAIN to
# caddy on HTTPS_PORT, and everything else to this address. Clients then use a
# plain https://DOMAIN URL with no port, which claude.ai connectors require.
SNI_FALLBACK=

# Cloudflare Tunnel token; only needed in tunnel mode
TUNNEL_TOKEN=
